{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gnustep-packager/schemas/gnustep-packager.schema.json",
  "title": "GNUstep Packager Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "package",
    "pipeline",
    "payload",
    "launch",
    "outputs",
    "validation"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "manufacturer"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "manufacturer": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "homepage": {
          "type": "string"
        },
        "license": {
          "type": "string"
        }
      }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workingDirectory",
        "shell",
        "build",
        "stage"
      ],
      "properties": {
        "workingDirectory": {
          "type": "string",
          "minLength": 1
        },
        "shell": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "bootstrapCommands",
            "environment"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "pwsh",
                "powershell",
                "bash",
                "sh",
                "msys2-bash"
              ]
            },
            "program": {
              "type": "string"
            },
            "msysRoot": {
              "type": "string"
            },
            "bootstrapCommands": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "environment": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "build": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command"
          ],
          "properties": {
            "command": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "stage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command",
            "outputRoot"
          ],
          "properties": {
            "command": {
              "type": "string",
              "minLength": 1
            },
            "outputRoot": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "validate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "command": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layoutVersion",
        "stageRoot",
        "appRoot",
        "runtimeRoot"
      ],
      "properties": {
        "layoutVersion": {
          "type": "integer",
          "const": 1
        },
        "stageRoot": {
          "type": "string",
          "minLength": 1
        },
        "appRoot": {
          "type": "string",
          "minLength": 1
        },
        "runtimeRoot": {
          "type": "string",
          "minLength": 1
        },
        "metadataRoot": {
          "type": "string",
          "minLength": 1
        },
        "resourceRoots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "runtimeSeedPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entryRelativePath",
        "workingDirectory"
      ],
      "properties": {
        "entryRelativePath": {
          "type": "string",
          "minLength": 1
        },
        "workingDirectory": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pathPrepend": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "resourceRoots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value"
                ],
                "properties": {
                  "value": {
                    "type": "string"
                  },
                  "policy": {
                    "type": "string",
                    "enum": [
                      "override",
                      "ifUnset"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "packageRoot",
        "logRoot",
        "tempRoot",
        "validationRoot"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "packageRoot": {
          "type": "string",
          "minLength": 1
        },
        "logRoot": {
          "type": "string",
          "minLength": 1
        },
        "tempRoot": {
          "type": "string",
          "minLength": 1
        },
        "validationRoot": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "hostDependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "windows": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "msys2Packages": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "linux": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "aptPackages": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "packagedDefaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultTheme": {
          "type": "string",
          "minLength": 1
        },
        "appDomain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "values"
          ],
          "properties": {
            "domain": {
              "type": "string",
              "minLength": 1
            },
            "values": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "type": "string",
                "minLength": 1
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "themeInputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "platforms",
          "required"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "repo": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "platforms": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "windows",
                "linux",
                "msi",
                "appimage"
              ]
            }
          },
          "required": {
            "type": "boolean"
          },
          "default": {
            "type": "boolean"
          },
          "workspacePath": {
            "type": "string",
            "minLength": 1
          },
          "build": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1
              },
              "installCommand": {
                "type": "string",
                "minLength": 1
              },
              "environment": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "smoke",
        "logs"
      ],
      "properties": {
        "smoke": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "kind",
            "requiredPaths",
            "timeoutSeconds"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "kind": {
              "type": "string",
              "enum": [
                "staged-layout"
              ]
            },
            "requiredPaths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "logs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "retainOnSuccess"
          ],
          "properties": {
            "retainOnSuccess": {
              "type": "boolean"
            }
          }
        },
        "packageContract": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requiredPaths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "requiredContent": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "notice-report",
                      "update-runtime-config",
                      "default-theme",
                      "metadata-file",
                      "updater-helper",
                      "bundled-theme",
                      "theme-resource"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "theme": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "installedResult": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requiredPaths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "requiredContent": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "notice-report",
                      "update-runtime-config",
                      "default-theme",
                      "metadata-file",
                      "updater-helper",
                      "bundled-theme",
                      "theme-resource"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "theme": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "updates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "provider": {
          "type": "string",
          "enum": [
            "github-release-feed"
          ]
        },
        "channel": {
          "type": "string",
          "minLength": 1
        },
        "feedUrl": {
          "type": "string"
        },
        "minimumCheckIntervalHours": {
          "type": "integer",
          "minimum": 1
        },
        "startupDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "publicEDKey": {
          "type": ["string", "null"],
          "description": "Base64 Ed25519 public key (32 bytes). When set, the updater refuses any payload without a valid edSignature in the feed."
        },
        "github": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "owner": {
              "type": "string"
            },
            "repo": {
              "type": "string"
            },
            "tagPattern": {
              "type": "string"
            },
            "releaseNotesUrlPattern": {
              "type": "string"
            }
          }
        }
      }
    },
    "integrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shortcutName": {
          "type": "string",
          "minLength": 1
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fileAssociations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "value"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "extension",
                  "mime"
                ]
              },
              "value": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "compliance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtimeNotices": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string"
              },
              "license": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "homepage": {
                "type": "string"
              },
              "stageRelativePath": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "platformOverrides": {
      "type": "object",
      "additionalProperties": false,
      "description": "Per-platform manifest overlays. The entry for the target platform (-Platform, else the requested backend's platform, else the host) merges over this manifest before defaults are applied: objects merge, arrays and scalars replace, and null removes a key.",
      "properties": {
        "windows": {
          "type": "object",
          "not": {
            "anyOf": [
              {
                "required": [
                  "schemaVersion"
                ]
              },
              {
                "required": [
                  "package"
                ]
              },
              {
                "required": [
                  "platformOverrides"
                ]
              }
            ]
          }
        },
        "linux": {
          "type": "object",
          "not": {
            "anyOf": [
              {
                "required": [
                  "schemaVersion"
                ]
              },
              {
                "required": [
                  "package"
                ]
              },
              {
                "required": [
                  "platformOverrides"
                ]
              }
            ]
          }
        },
        "macos": {
          "type": "object",
          "not": {
            "anyOf": [
              {
                "required": [
                  "schemaVersion"
                ]
              },
              {
                "required": [
                  "package"
                ]
              },
              {
                "required": [
                  "platformOverrides"
                ]
              }
            ]
          }
        }
      }
    },
    "backends": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "msi": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "upgradeCode": {
              "type": "string",
              "pattern": "^[0-9a-fA-F-]{36}$"
            },
            "installScope": {
              "type": "string",
              "enum": [
                "perMachine",
                "perUser"
              ]
            },
            "productName": {
              "type": "string"
            },
            "shortcutName": {
              "type": "string"
            },
            "installDirectoryName": {
              "type": "string"
            },
            "launcherFileName": {
              "type": "string"
            },
            "iconRelativePath": {
              "type": "string"
            },
            "updates": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "feedUrl": {
                  "type": "string"
                }
              }
            },
            "artifactNamePattern": {
              "type": "string"
            },
            "portableArtifactNamePattern": {
              "type": "string"
            },
            "fallbackRuntimeRoot": {
              "type": "string"
            },
            "runtimeSearchRoots": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "unresolvedDependencyPolicy": {
              "type": "string",
              "enum": [
                "fail",
                "warn"
              ]
            },
            "ignoredRuntimeDependencies": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "wix": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "downloadUrl": {
                  "type": "string",
                  "minLength": 1
                },
                "toolRoot": {
                  "type": "string",
                  "minLength": 1
                },
                "skipValidation": {
                  "type": "boolean"
                },
                "suppressedIces": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "signing": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "toolPath": {
                  "type": "string"
                },
                "timestampUrl": {
                  "type": "string"
                },
                "certificateSha1": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "additionalArguments": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "appimage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "appDirName": {
              "type": "string"
            },
            "desktopEntryName": {
              "type": "string"
            },
            "iconRelativePath": {
              "type": "string"
            },
            "updates": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "feedUrl": {
                  "type": "string"
                },
                "embedUpdateInformation": {
                  "type": "boolean"
                },
                "updateInformation": {
                  "type": "string"
                },
                "releaseSelector": {
                  "type": "string"
                },
                "zsyncArtifactNamePattern": {
                  "type": "string"
                }
              }
            },
            "artifactNamePattern": {
              "type": "string"
            },
            "toolRoot": {
              "type": "string"
            },
            "downloadUrl": {
              "type": "string"
            },
            "skipAppStreamValidation": {
              "type": "boolean"
            },
            "validation": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "runtimeClosure": {
                  "type": "string",
                  "enum": [
                    "strict",
                    "off"
                  ]
                },
                "allowedSystemLibraries": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "allowedExternalRunpaths": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "smoke": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "launch-only",
                    "open-file",
                    "custom-arguments",
                    "marker-file"
                  ]
                },
                "arguments": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "environment": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "documentStageRelativePath": {
                  "type": "string",
                  "minLength": 1
                },
                "startupSeconds": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "mode": {
                        "const": "open-file"
                      }
                    },
                    "required": [
                      "mode"
                    ]
                  },
                  "then": {
                    "required": [
                      "documentStageRelativePath"
                    ]
                  }
                }
              ]
            }
          }
        },
        "dmg": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "appBundleName": {
              "type": "string",
              "minLength": 1,
              "description": "App bundle under payload.appRoot. Supports {name}, {version}, {packageId}."
            },
            "volumeName": {
              "type": "string",
              "description": "Mounted volume name. Empty uses package.displayName (or package.name)."
            },
            "artifactNamePattern": {
              "type": "string",
              "minLength": 1,
              "description": "Supports {name}, {version}, {packageId}, {backend}, {arch} (universal, arm64 or x86_64, detected with lipo)."
            },
            "filesystem": {
              "type": "string",
              "enum": [
                "APFS",
                "HFS+"
              ]
            },
            "format": {
              "type": "string",
              "enum": [
                "UDZO",
                "ULFO"
              ]
            },
            "applicationsLink": {
              "type": "boolean"
            },
            "backgroundImageRelativePath": {
              "type": "string",
              "description": "Stage-relative background image (PNG or TIFF). Empty for none."
            },
            "finderLayout": {
              "type": "string",
              "enum": [
                "auto",
                "applescript",
                "off"
              ]
            },
            "finderLayoutTimeoutSeconds": {
              "type": "integer",
              "minimum": 5
            },
            "window": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "x": {
                  "type": "integer"
                },
                "y": {
                  "type": "integer"
                },
                "width": {
                  "type": "integer",
                  "minimum": 200
                },
                "height": {
                  "type": "integer",
                  "minimum": 150
                },
                "iconSize": {
                  "type": "integer",
                  "minimum": 16,
                  "maximum": 512
                },
                "textSize": {
                  "type": "integer",
                  "minimum": 10,
                  "maximum": 16
                },
                "appIconPosition": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "x": {
                      "type": "integer"
                    },
                    "y": {
                      "type": "integer"
                    }
                  }
                },
                "applicationsIconPosition": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "x": {
                      "type": "integer"
                    },
                    "y": {
                      "type": "integer"
                    }
                  }
                },
                "noticeIconPosition": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "x": {
                      "type": "integer"
                    },
                    "y": {
                      "type": "integer"
                    }
                  }
                }
              }
            },
            "noticeReport": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "fileName": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "signing": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "identity": {
                  "type": "string",
                  "minLength": 1,
                  "description": "codesign identity. '-' is ad-hoc."
                },
                "resign": {
                  "type": "boolean"
                },
                "deep": {
                  "type": "boolean"
                },
                "hardenedRuntime": {
                  "type": "boolean"
                },
                "entitlementsPath": {
                  "type": "string",
                  "description": "Entitlements plist, relative to the manifest directory."
                },
                "keychain": {
                  "type": "string"
                },
                "signDmg": {
                  "type": "boolean"
                },
                "additionalArguments": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "notarization": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "keychainProfileEnvVar": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                  "description": "Name of the environment variable that holds the notarytool keychain profile name. Never the profile or a secret itself."
                },
                "staple": {
                  "type": "boolean"
                },
                "required": {
                  "type": "boolean"
                }
              }
            },
            "validation": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "requireSignature": {
                  "type": "boolean"
                },
                "requireGatekeeperAcceptance": {
                  "type": "boolean"
                }
              }
            },
            "smoke": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "startupSeconds": {
                  "type": "integer",
                  "minimum": 1
                },
                "arguments": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "environment": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
